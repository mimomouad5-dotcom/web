// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects Project[]
  @@map("users")
}

model Project {
  id        String   @id @default(cuid())
  userId    String
  title     String
  topic     String
  status    String   @default("draft") // draft, processing, completed, failed
  language  String   @default("en") // en, ar, fr
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions ProjectVersion[]
  jobs     Job[]

  @@index([userId])
  @@map("projects")
}

model ProjectVersion {
  id        String   @id @default(cuid())
  projectId String
  version   Int      @default(1)
  status    String   @default("draft") // draft, processing, completed
  presentationJson Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sources Source[]
  claims  Claim[]
  slides  Slide[]

  @@index([projectId])
  @@map("project_versions")
}

model Source {
  id                 String   @id @default(cuid())
  projectVersionId   String
  type               String   // web, academic, image
  url                String
  title              String?
  abstract           String?   @db.Text
  content            String?   @db.Text
  credibilityScore   Float    @default(0.5)
  metadata           Json?
  retrievedAt        DateTime @default(now())
  createdAt          DateTime @default(now())

  projectVersion ProjectVersion @relation(fields: [projectVersionId], references: [id], onDelete: Cascade)
  claims         ClaimEvidence[]

  @@index([projectVersionId])
  @@map("sources")
}

model Claim {
  id                 String   @id @default(cuid())
  projectVersionId   String
  text               String   @db.Text
  confidence         Float    @default(0.5)
  verificationStatus String   @default("unverified") // verified, disputed, uncertain
  createdAt          DateTime @default(now())

  projectVersion ProjectVersion @relation(fields: [projectVersionId], references: [id], onDelete: Cascade)
  evidence       ClaimEvidence[]
  slides         Slide[]

  @@index([projectVersionId])
  @@map("claims")
}

model ClaimEvidence {
  id        String   @id @default(cuid())
  claimId   String
  sourceId  String
  strength  Float    @default(0.5) // 0-1
  createdAt DateTime @default(now())

  claim  Claim   @relation(fields: [claimId], references: [id], onDelete: Cascade)
  source Source  @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@unique([claimId, sourceId])
  @@index([claimId])
  @@index([sourceId])
  @@map("claim_evidence")
}

model Slide {
  id                 String   @id @default(cuid())
  projectVersionId   String
  slideNumber        Int
  title              String?
  content            Json?
  layout             String   @default("content") // title, content, two-column, etc
  notes              String?   @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  projectVersion ProjectVersion @relation(fields: [projectVersionId], references: [id], onDelete: Cascade)
  claims         Claim[]

  @@unique([projectVersionId, slideNumber])
  @@index([projectVersionId])
  @@map("slides")
}

model Job {
  id        String   @id @default(cuid())
  projectId String
  type      String   // research_run, source_ingestion, claim_mapping, synthesis, outline_generation, slide_writing, pptx_export, qa_validation
  status    String   @default("pending") // pending, processing, completed, failed
  progress  Int      @default(0)
  errorMsg  String?   @db.Text
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([status])
  @@map("jobs")
}
